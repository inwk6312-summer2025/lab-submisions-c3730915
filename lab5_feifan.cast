[851.17086, "o", "\u001b[?25lging\r\n\u001b[38;5;81mimport\u001b[m requests\u001b[2;16H\u001b[K\u001b[3;1H\u001b[38;5;81mfrom\u001b[m requests.auth \u001b[38;5;81mimport\u001b[m HTTPBasicAuth\u001b[3;40H\u001b[K\u001b[4;1Himpor\u001b[4;6H\u001b[K\u001b[4;6H\u001b[?25h"]
[851.172359, "o", "\u001b[?25l\r\u001b[38;5;81mimport\u001b[m json\u001b[5;1H\u001b[K\u001b[6;1H\u001b[96m# 日志设置\u001b[m\u001b[6;11H\u001b[K\u001b[7;1Hlogging.basicCo\u001b[7;16H\u001b[K\u001b[7;16H\u001b[?25h"]
[851.173754, "o", "\u001b[?25lnfig(level=logging.INFO, \u001b[1m\u001b[96mformat\u001b[m=\u001b[95m'%(name)s - %(leveln\u001b[?25h"]
