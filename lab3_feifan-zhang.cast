[1077.949005, "o", "\u001b[?25lnja2 \u001b[38;5;81mimport\u001b[m Environment, FileSystemLoader\r\n\u001b[38;5;81mimport\u001b[m y\u001b[3;9H\u001b[K\u001b[3;9H\u001b[?25h"]
[1077.949914, "o", "\u001b[?25laml\r\n\u001b[96m# Declare template environ\u001b[m\u001b[4;27H\u001b[K\u001b[4;27H\u001b[?25h"]
[1077.950673, "o", "\u001b[?25l\u001b[96mment\u001b[m\r\nENV = Envir\u001b[5;12H\u001b[K\u001b[5;12H\u001b[?25h"]
[1077.959302, "o", "\u001b[?25lonment(loader=FileSystemLoader(\u001b[95m'.'\u001b[m))\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96mget_interface_speed\u001b[m\u001b[6;24H\u001b[K\u001b[6;24H\u001b[?25h"]
[1077.960185, "o", "\u001b[?25l(interface_name):\r\n\u001b[95m\"\"\" get_interface_speed returns the default\u001b[m\u001b[7;44H\u001b[K\u001b[7;44H\u001b[?25h"]
[1077.960983, "o", "\u001b[?25l\u001b[95m Mbps value for a given\r\nnetwork interface by looking for certa\u001b[m\u001b[8;39H\u001b[K\u001b[8;39H\u001b[?25h"]
[1077.961514, "o", "\u001b[?25l\u001b[95min keywor\u001b[?25h"]
[1077.966242, "o", "\u001b[?25lds in the name\r\n\"\"\"\u001b[m\u001b[9;4H\u001b[K\u001b[10;1H\u001b[93mif\u001b[m \u001b[95m'gigabit'\u001b[m \u001b[93min\u001b[m interface_name.lower():\u001b[10;40H\u001b[K\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h"]
[1077.967424, "o", "\u001b[?25l\u001b[93mreturn\u001b[m \u001b[95m1000\u001b[m\r\n\u001b[93mif\u001b[m \u001b[95m'fast'\u001b[m \u001b[93min\u001b[m interface_name.lower():\u001b[12;37H\u001b[K\u001b[13;1H\u001b[93mreturn\u001b[m \u001b[95m100\u001b[m\u001b[13;11H\u001b[K\u001b[14;1H\u001b[96m#\u001b[m\u001b[14;2H\u001b[K\u001b[14;2H\u001b[?25h"]
[1077.968197, "o", "\u001b[?25l\u001b[96m Filters are added to the ENV object after declaration. Note \u001b[?25h"]
[1077.969161, "o", "\u001b[?25lthat we're\r\n# actually passing in our \"get_interface_speed\" fun\u001b[m\u001b[15;52H\u001b[K\u001b[15;52H\u001b[?25h"]
[1077.974284, "o", "\u001b[?25l\u001b[96mction and not running\r\n# it--the template engi\u001b[m\u001b[16;24H\u001b[K\u001b[16;24H\u001b[?25h"]
[1077.975554, "o", "\u001b[?25l\u001b[96mne will execute this function when we call\r\n# template.render()\u001b[m\u001b[17;20H\u001b[K\u001b[18;1HENV.f\u001b[18;6H\u001b[K\u001b[18;6H\u001b[?25h"]
[1077.976498, "o", "\u001b[?25lilters[\u001b[95m'get_interface_speed'\u001b[m] = get_interface_speed\r\ntemplate = ENV.\u001b[19;16H\u001b[K\u001b[19;16H\u001b[?25h"]
