[4071.897315, "o", "\u001b[?25l\u001b[30;1H\u001b[1m-- INSERT --\u001b[m\u001b[30;13H\u001b[K\u001b[30;103H0,1\u001b[11CAll\u001b[1;1H\u001b[38;5;81mimport\u001b[m yam\u001b[?25h"]
[4071.901914, "o", "\u001b[?25ll\r\n\u001b[38;5;81mfrom\u001b[m jinja2 \u001b[38;5;81mimport\u001b[m Environment, FileSystemLoader\u001b[2;49H\u001b[K\u001b[3;1H\u001b[38;5;81mfrom\u001b[m netmiko im\u001b[3;16H\u001b[K\u001b[3;16H\u001b[?25h"]
[4071.903066, "o", "\u001b[?25l\b\b\u001b[38;5;81mimport\u001b[m Netmiko\u001b[4;1H\u001b[K\u001b[5;1H\u001b[K\u001b[5;1H\u001b[?25h"]
[4071.90457, "o", "\u001b[?25l\u001b[96m# Load YAML file\u001b[?25h"]
[4071.908473, "o", "\u001b[?25ls\u001b[m\r\nhosts = yaml.load(\u001b[1m\u001b[96mopen\u001b[m(\u001b[95m'hosts.yml'\u001b[m), Loader=yaml.Safe\u001b[6;54H\u001b[K\u001b[6;54H\u001b[?25h"]
[4071.909467, "o", "\u001b[?25lLoader)\r\ninterfaces = yaml\u001b[7;18H\u001b[K\u001b[7;18H\u001b[?25h"]
[4071.91803, "o", "\u001b[?25l.load(\u001b[1m\u001b[96mopen\u001b[m(\u001b[95m'inte\u001b[?25h\u001b[?25lrfaces.yml'\u001b[m), Loader=yaml.SafeLoader)\u001b[8;1H\u001b[K\u001b[9;1H\u001b[96m# Load Jinja2 template\u001b[m\u001b[9;23H\u001b[K\u001b[10;1Henv\u001b[10;4H\u001b[K\u001b[10;4H\u001b[?25h"]
[4071.919525, "o", "\u001b[?25l = Environment(\r\n    loader=FileSystemLoader(\u001b[95m'.'\u001b[m),\u001b[11;34H\u001b[K\u001b[12;1H    trim_block\u001b[12;15H\u001b[K\u001b[12;15H\u001b[?25h"]
[4071.921168, "o", "\u001b[?25ls=\u001b[1m\u001b[96mTrue\u001b[m,\r\n    lstrip_blocks=\u001b[1m\u001b[96mTrue\u001b[m\u001b[13;23H\u001b[K\u001b[14;1H)\u001b[14;2H\u001b[K\u001b[15;1Htemplate = env.get_template(\u001b[95m'in\u001b[m\u001b[15;32H\u001b[K\u001b[15;32H\u001b[?25h"]
[4071.926175, "o", "\u001b[?25l\u001b[95mterfaces_config_template.j2'\u001b[m)\u001b[16;1H\u001b[K\u001b[17;1H\u001b[96m# Render the loopback configurat\u001b[m\u001b[17;33H\u001b[K\u001b[17;33H\u001b[?25h"]
[4071.927399, "o", "\u001b[?25l\u001b[96mion\u001b[m\r\nloopback_config = template.render(data=interfaces)\u001b[18;51H\u001b[K\u001b[19;1H\u001b[K\u001b[20;1H\u001b[96m# Push \u001b[m\u001b[20;8H\u001b[K\u001b[20;8H\u001b[?25h"]
[4071.928321, "o", "\u001b[?25l\u001b[96mconfig to each host\u001b[m\r\n\u001b[93mfor\u001b[m host \u001b[93min\u001b[m hosts[\u001b[95m\"hosts\"\u001b[m]:\u001b[21;28H\u001b[K\u001b[22;1H    \u001b[1m\u001b[96mprint\u001b[m(f\u001b[95m\"\u001b[m\u001b[22;13H\u001b[K\u001b[22;13H\u001b[?25h"]
[4071.932457, "o", "\u001b[?25l\u001b[95m🔗\u001b[22;15H Connecting to {host['name']}...\"\u001b[m)\r\n    net_connect = Netmiko(\u001b[23;27H\u001b[K\u001b[24;1H\u001b[K\u001b[24;1H\u001b[?25h"]
[4071.933447, "o", "\u001b[?25l\u001b[8Chost=host[\u001b[95m\"name\"\u001b[m],\r\n        username=host[\u001b[95m\"username\"\u001b[m],\u001b[25;35H\u001b[K\u001b[26;1H \u001b[26;2H\u001b[K\u001b[26;2H\u001b[?25h"]
[4071.934813, "o", "\u001b[?25l\u001b[7Cpassword=host[\u001b[95m\"password\"\u001b[m],\r\n        port=host[\u001b[95m\"port\"\u001b[m],\u001b[27;27H\u001b[K\u001b[28;1H  \u001b[28;3H\u001b[K\u001b[28;3H\u001b[?25h"]
[4071.939528, "o", "\u001b[?25l      device_type=host[\u001b[95m\"type\"\u001b[m]\r\n    )\u001b[29;6H\u001b[K\u001b[1;29r\u001b[1;1H\u001b[2M\u001b[1;30r\u001b[29;5H\u001b[1m\u001b[96mprint\u001b[m(f\u001b[95m\"✅\u001b[29;15H Logged in\u001b[m\u001b[30;11H\u001b[1m(paste) --\u001b[m\u001b[30;103H\u001b[K\u001b[29;25H\u001b[?25h"]
[4071.94048, "o", "\u001b[?25l\u001b[95mto {host['name']} successfully\"\u001b[m)\u001b[29;30H\u001b[?25h"]
[4071.941678, "o", "\u001b[?25l\u001b[1;29r\u001b[1;1H\u001b[2M\u001b[1;30r\u001b[29;5Houtput = net_connect.send_config_set(loopback_config.splitlines())\u001b[29;20H\u001b[?25h"]
[4071.946067, "o", "\u001b[?25l\u001b[1;29r\u001b[29;1H\r\n\u001b[1;30r\u001b[29;5H\u001b[1m\u001b[96mprint\u001b[m(f\u001b[95m\"📤\u001b[29;15H Pushed config to {host['name']}:\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m{output}\"\u001b[m)\u001b[29;22H\u001b[?25h"]
[4071.947296, "o", "\u001b[?25l\u001b[1;29r\u001b[1;1H\u001b[2M\u001b[1;30r\u001b[29;5Hnet_connect.disconnect()\u001b[11C\u001b[?25h"]
[4071.947926, "o", "\u001b[?25l\u001b[30;1H\u001b[K"]
