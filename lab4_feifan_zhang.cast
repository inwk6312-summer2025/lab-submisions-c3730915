[3386.051007, "o", "\u001b[?25l{\r\n        \u001b[95m\"device_type\"\u001b[m: \u001b[95m\"cisco_ios\"\u001b[m,\u001b[10;36H\u001b[K\u001b[11;1H        \u001b[95m\"ip\"\u001b[m: \u001b[95m\"192.168.1.10\u001b[m\u001b[11;28H\u001b[K\u001b[11;28H\u001b[?25h"]
[3386.052274, "o", "\u001b[?25l\u001b[95m1\"\u001b[m,\r\n        \u001b[95m\"username\"\u001b[m: \u001b[95m\"student\"\u001b[m,\u001b[12;31H\u001b[K\u001b[13;1H        \u001b[95m\"password\"\u001b[m: \u001b[95m\"Meilab12\u001b[m\u001b[13;30H\u001b[K\u001b[13;30H\u001b[?25h"]
[3386.053557, "o", "\u001b[?25l\u001b[95m3\"\u001b[m,\r\n        \u001b[95m\"secret\"\u001b[m: \u001b[95m\"cisco\"\u001b[m,\u001b[14;27H\u001b[K\u001b[15;1H        \u001b[95m\"port\"\u001b[m: \u001b[95m\"22\"\u001b[m,\u001b[15;22H\u001b[K\u001b[16;1H    }\u001b[16;6H\u001b[K\u001b[17;1H]\u001b[17;2H\u001b[K\u001b[18;1H\u001b[K\u001b[19;1Hfo\u001b[19;3H\u001b[K\u001b[19;3H\u001b[?25h"]
[3386.057489, "o", "\u001b[?25l\r\u001b[93mfor\u001b[m device \u001b[93min\u001b[m devices:\r\n    \u001b[1m\u001b[96mprint\u001b[m(f\u001b[95m\"\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m🔧\u001b[20;17H Connecting to {device['\u001b[m\u001b[20;41H\u001b[K\u001b[20;41H\u001b[?25h"]
[3386.058786, "o", "\u001b[?25l\u001b[95mip']} to apply config from file...\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m\"\u001b[m)\r\n    net_connect = Netmik\u001b[21;25H\u001b[K\u001b[21;25H\u001b[?25h"]
