[940.491542, "o", "\u001b[22;1t"]
[940.492944, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[30;1H\"get_interfaces.py\""]
[940.493544, "o", " 35L, 1078C"]
[940.499744, "o", "\u001b[2;1H▽\u001b[6n"]
[940.500234, "o", "\u001b[2;1H  \u001b[1;1H"]
[940.500627, "o", "\u001b[>c"]
[940.50102, "o", "\u001b]10;?\u0007\u001b]11;?\u0007"]
[940.505904, "o", "\u001b[1;1H\u001b[35mimport\u001b[m logging\r\n\u001b[35mimport\u001b[m requests\r\n\u001b[35mfrom\u001b[m requests.auth \u001b[35mimport\u001b[m HTTPBasicAuth\r\n\u001b[35mimport\u001b[m json\r\n\r\n\u001b[34m# 日志设置\u001b[m\r\nlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\n\r\n\u001b[34m# 设备登录信息与地址\u001b[m\r\nHOST = \u001b[31m'192.168.1.101'\u001b[m\r\nUSER = \u001b[31m'student'\u001b[m\r\nPASS = \u001b[31m'Meilab123'\u001b[m\r\n\r\n\u001b[34m# 构建基础 URL\u001b[m\r\nBASE_URL = f\u001b[31m'http://{HOST}/restconf/api/running/'\u001b[m\r\n\r\n\u001b[34m# 定义获取接口的函数\u001b[m\r\n\u001b[38;5;130mdef\u001b[m \u001b[36mget_interfaces\u001b[m(append_url):\r\n    url = BASE_URL + append_url\r\n    auth = HTTPBasicAuth(USER, PASS)\r\n    headers = {\u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m}  \u001b[34m# 请求返回 JSON 格式\u001b[m\r\n    logging.info(f\u001b[31m\"URL ==> {url}\"\u001b[m)\u001b[24;5Hresponse = requests.get(url, auth=auth, headers=headers)\u001b[26;5H\u001b[38;5;130mif\u001b[m response.status_code == \u001b[31m200\u001b[m:\u001b[27;9Hlogging.info(f\u001b[31m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[28;"]
[940.506473, "o", "9H\u001b[38;5;130mreturn\u001b[m json.dumps(response.json(), sort_keys=\u001b[36mTrue\u001b[m, indent=\u001b[31m4\u001b[m)\r\n    \u001b[38;5;130melse\u001b[m:\u001b[30;103H20,1\u001b[10CTop\u001b[20;1H\u001b[?25h"]
[940.543571, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[1;1H\u001b[38;5;81mimport\u001b[m logging\r\n\u001b[38;5;81mimport\u001b[m requests\r\n\u001b[38;5;81mfrom\u001b[m requests.auth \u001b[38;5;81mimport\u001b[m HTTPBasicAuth\r\n\u001b[38;5;81mimport\u001b[m json\r\n\r\n\u001b[96m# 日志设置\u001b[m\r\nlogging.basicConfig(level=logging.INFO, \u001b[1m\u001b[96mformat\u001b[m=\u001b[95m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\n\r\n\u001b[96m# 设备登录信息与地址\u001b[m\r\nHOST = \u001b[95m'192.168.1.101'\u001b[m\r\nUSER = \u001b[95m'student'\u001b[m\r\nPASS = \u001b[95m'Meilab123'\u001b[m\r\n\r\n\u001b[96m# 构建基础 URL\u001b[m\r\nBASE_URL = f\u001b[95m'http://{HOST}/restconf/api/running/'\u001b[m\r\n\r\n\u001b[96m# 定义获取接口的函数\u001b[m\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96mget_interfaces\u001b[m(append_url):\r\n    url = BASE_URL + append_url\r\n    auth = HTTPBasicAuth(USER, PASS)\r\n    headers = {\u001b[95m'Accept'\u001b[m: \u001b[95m'application/vnd.yang.data+json'\u001b[m}  \u001b[96m# 请求返回 JSON 格式\u001b[m\r\n    logging.info(f\u001b[95m\"URL ==> {url}\"\u001b[m)\u001b[24;5Hresponse = requests.get(url, auth=auth, headers=headers)\u001b[26;5H\u001b[93mif\u001b[m response.status_code == \u001b[95m200\u001b[m:\u001b[27;9Hlogging.info(f\u001b[95m\"Request was successf"]
[940.544339, "o", "ul on {HOST}, Code: {response.status_code}\"\u001b[m)\u001b[28;9H\u001b[93mreturn\u001b[m json.dumps(response.json(), sort_keys=\u001b[1m\u001b[96mTrue\u001b[m, indent=\u001b[95m4\u001b[m)\r\n    \u001b[93melse\u001b[m:\u001b[30;103H20,1\u001b[10CTop\r\"get_interfaces.py\" 35L, 1078C\u001b[20;1H\u001b[?25h"]
