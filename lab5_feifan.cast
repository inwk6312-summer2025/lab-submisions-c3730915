[120.478851, "o", "\u001b]0;student@6312vm-csr10: ~/Desktop/restconf-lab\u0007\u001b[01;32mstudent@6312vm-csr10\u001b[00m:\u001b[01;34m~/Desktop/restconf-lab\u001b[00m$ "]
[125.090617, "o", "apt-get --fix-mi"]
[125.139896, "o", "ssing"]
[126.093827, "o", "\r\n"]
[126.102825, "o", "apt 2.0.6 (amd64)"]
[126.103429, "o", "\r\n"]
[126.103874, "o", "Usage: apt-get [options] command"]
[126.104245, "o", "\r\n"]
[126.104644, "o", "       apt-get [options] install|remove pkg1 [pkg2 ...]"]
[126.105013, "o", "\r\n"]
[126.105406, "o", "       apt-get [options] source pkg1 [pkg2 ...]"]
[126.105842, "o", "\r\n"]
[126.106202, "o", "\r\n"]
[126.106589, "o", "apt-get is a command line interface for retrieval of packages"]
[126.106949, "o", "\r\n"]
[126.107289, "o", "and information about them from authenticated sources and"]
[126.107709, "o", "\r\n"]
[126.108085, "o", "for installation, upgrade and removal of packages together"]
[126.108397, "o", "\r\n"]
[126.108722, "o", "with their dependencies."]
[126.109095, "o", "\r\n"]
[126.109479, "o", "\r\n"]
[126.109922, "o", "Most used commands:"]
[126.110286, "o", "\r\n"]
[126.110701, "o", "  update - Retrieve new lists of packages"]
[126.111062, "o", "\r\n"]
[126.111417, "o", "  upgrade - Perform an upgrade"]
[126.111771, "o", "\r\n"]
[126.112175, "o", "  install - Install new packages (pkg is libc6 not libc6.deb)"]
[126.11255, "o", "\r\n"]
[126.11295, "o", "  reinstall - Reinstall packages (pkg is libc6 not libc6.deb)"]
[126.113351, "o", "\r\n"]
[126.11373, "o", "  remove - Remove packages"]
[126.114134, "o", "\r\n"]
[126.114498, "o", "  purge - Remove packages and config files"]
[126.114734, "o", "\r\n"]
[126.115044, "o", "  autoremove - Remove automatically all unused packages"]
[126.11527, "o", "\r\n"]
[126.115532, "o", "  dist-upgrade - Distribution upgrade, see apt-get(8)"]
[126.115748, "o", "\r\n"]
[126.116005, "o", "  dselect-upgrade - Follow dselect selections"]
[126.116222, "o", "\r\n"]
[126.116483, "o", "  build-dep - Configure build-dependencies for source packages"]
[126.117461, "o", "\r\n"]
[126.117731, "o", "  satisfy - Satisfy dependency strings"]
[126.117965, "o", "\r\n"]
[126.118243, "o", "  clean - Erase downloaded archive files"]
[126.118476, "o", "\r\n"]
[126.118735, "o", "  autoclean - Erase old downloaded archive files"]
[126.118959, "o", "\r\n"]
[126.119226, "o", "  check - Verify that there are no broken dependencies"]
[126.119514, "o", "\r\n  source - Download source archives\r\n  download - Download the binary package into the current directory\r\n  changelog - Download and display the changelog for the given package\r\n\r\nSee apt-get(8) for more information about the available commands.\r\n"]
[126.12109, "o", "Configuration options and syntax is detailed in apt.conf(5).\r\nInformation about how to configure sources can be found in sources.list(5).\r\nPackage and version choices can be expressed via apt_preferences(5).\r\nSecurity details are available in apt-secure(8).\r\n                                        This APT has Super Cow Powers.\r\n\u001b]0;student@6312vm-csr10: ~/Desktop/restconf-lab\u0007\u001b[01;32mstudent@6312vm-csr10\u001b[00m:\u001b[01;34m~/Desktop/restconf-lab\u001b[00m$ "]
[129.080501, "o", "apt-get --fix-missing"]
