[1104.208204, "o", "\u001b[?25l\u001b[m\u001b[96m# 导入 Jinja2 和 PyYAML 库\u001b[m\r\nfro\u001b[2;4H\u001b[K\u001b[2;4H\u001b[?25h"]
[1104.210716, "o", "\u001b[?25l\r\u001b[38;5;81mfrom\u001b[m jinja2 \u001b[38;5;81mimport\u001b[m Environment, FileSystemLoader\r\n\u001b[38;5;81mimport\u001b[m\u001b[3;7H\u001b[K\u001b[3;7H\u001b[?25h"]
[1104.211484, "o", "\u001b[?25l yaml\u001b[4;1H\u001b[K\u001b[5;1H\u001b[96m# 声明模板环境（当前目录）\u001b[m\u001b[5;27H\u001b[K\u001b[6;1HENV = Env\u001b[6;10H\u001b[K\u001b[6;10H\u001b[?25h"]
[1104.212037, "o", "\u001b[?25lironment(load\u001b[?25h"]
[1104.219266, "o", "\u001b[?25ler=FileSystemLoader(\u001b[95m'.'\u001b[m))\u001b[7;1H\u001b[K\u001b[8;1H\u001b[96m# 自定义过滤器函数\u001b[m\u001b[8;19H\u001b[K\u001b[8;19H\u001b[?25h"]
[1104.220579, "o", "\u001b[?25l\u001b[96m：根据接口名称返回 Mbps 速率\u001b[m\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96mget_interface_\u001b[m\u001b[9;19H\u001b[K\u001b[9;19H\u001b[?25h"]
[1104.221726, "o", "\u001b[?25l\u001b[1m\u001b[96mspeed\u001b[m(interface_name):\r\n    \u001b[95m\"\"\"\u001b[m\u001b[10;8H\u001b[K\u001b[11;1H\u001b[95m    get_interface_speed 根\u001b[m\u001b[11;27H\u001b[K\u001b[11;27H\u001b[?25h"]
[1104.229049, "o", "\u001b[?25l\u001b[95m据接口名称返回默认 Mbps 速度，\r\n    通过检测\u001b[m\u001b[12;13H\u001b[K\u001b[12;13H\u001b[?25h"]
[1104.229811, "o", "\u001b[?25l\u001b[95m名称中是否包含 'gigabit' 或 'fast' 关键词。\r\n    \u001b[m\u001b[13;5H\u001b[K\u001b[13;5H\u001b[?25h"]
[1104.230785, "o", "\u001b[?25l\u001b[95m\"\"\"\u001b[m\r\n    \u001b[93mif\u001b[m \u001b[95m'gigabit'\u001b[m \u001b[93min\u001b[m interface_name.lower():\u001b[14;44H\u001b[K\u001b[15;1H        ret\u001b[15;12H\u001b[K\u001b[15;12H\u001b[?25h"]
[1104.231838, "o", "\u001b[?25l\b\b\b\u001b[93mreturn\u001b[m \u001b[95m1000\u001b[m\r\n    \u001b[93mif\u001b[m \u001b[95m'fast'\u001b[m \u001b[93min\u001b[m interface_name.lower():\u001b[16;41H\u001b[K\u001b[17;1H        ret\u001b[17;12H\u001b[K\u001b[17;12H\u001b[?25h"]
[1104.236298, "o", "\u001b[?25l\b\b\b\u001b[93mreturn\u001b[m \u001b[95m100\u001b[m\r\n    \u001b[93mreturn\u001b[m \u001b[95m'unknown'\u001b[m\u001b[18;21H\u001b[K\u001b[19;1H\u001b[K\u001b[20;1H\u001b[96m# 将函数注册为 Jinja2 过\u001b[m\u001b[20;25H\u001b[K\u001b[20;25H\u001b[?25h"]
[1104.237213, "o", "\u001b[?25l\u001b[96m滤器（注意：传的是函数名，不是函数调用）\u001b[m\r\nE\u001b[21;2H\u001b[K\u001b[21;2H\u001b[?25h"]
[1104.238206, "o", "\u001b[?25lNV.filters[\u001b[95m'get_interface_speed'\u001b[m] = get_interface_speed\u001b[22;1H\u001b[K\u001b[23;1H\u001b[96m# 加\u001b[m\u001b[23;5H\u001b[K\u001b[23;5H\u001b[?25h"]
