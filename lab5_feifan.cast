[851.183995, "o", "\u001b[?25l\u001b[96m录信息与地址\u001b[m\r\nHOST = \u001b[95m'192.168.1.101'\u001b[m\u001b[10;23H\u001b[K\u001b[11;1HUSER = \u001b[95m'student'\u001b[m\u001b[11;17H\u001b[K\u001b[12;1HPASS =\u001b[12;7H\u001b[K\u001b[12;7H\u001b[?25h"]
[851.18523, "o", "\u001b[?25l \u001b[95m'Meilab123'\u001b[m\u001b[13;1H\u001b[K\u001b[14;1H\u001b[96m# 构建基础 URL\u001b[m\u001b[14;15H\u001b[K\u001b[15;1HBASE_URL = f\u001b[95m'http://{HOST}/rest\u001b[m\u001b[15;32H\u001b[K\u001b[15;32H\u001b[?25h"]
[851.186527, "o", "\u001b[?25l\u001b[95mconf/api/running/'\u001b[m\u001b[16;1H\u001b[K\u001b[17;1H\u001b[96m# 定义获取接口的函数\u001b[m\u001b[17;21H\u001b[K\u001b[18;1H\u001b[93mdef\u001b[m \u001b[1m\u001b[96mget_inter\u001b[m\u001b[18;14H\u001b[K\u001b[18;14H\u001b[?25h"]
[851.190794, "o", "\u001b[?25l\u001b[1m\u001b[96mfaces\u001b[m(append_url):\r\n    url = BASE_URL + append_url\u001b[19;32H\u001b[K\u001b[20;1H    auth = H\u001b[20;13H\u001b[K\u001b[20;13H\u001b[?25h"]
[851.191763, "o", "\u001b[?25lTTPBasicAuth(USER, PASS)\r\n    headers = {\u001b[95m'Accept'\u001b[m: \u001b[95m'application/\u001b[m\u001b[21;39H\u001b[K\u001b[21;39H\u001b[?25h"]
[851.192872, "o", "\u001b[?25l\u001b[95mvnd.yang.data+json'\u001b[m}  \u001b[96m# 请求返回 JSON 格式\u001b[m\r\n    logging.\u001b[93min\u001b[m\u001b[22;15H\u001b[K\u001b[22;15H\u001b[?25h"]
[851.196943, "o", "\u001b[?25l\b\binfo(f\u001b[95m\"URL ==> {url}\"\u001b[m)\r\n    \u001b[23;5H\u001b[K\u001b[24;1H    response = requests.get(url, auth\u001b[24;38H\u001b[K\u001b[24;38H\u001b[?25h"]
[851.197626, "o", "\u001b[?25l=auth, headers=headers)\r\n    \u001b[25;5H\u001b[K\u001b[26;1H    \u001b[93mif\u001b[m response.status_code == \u001b[95m200\u001b[m\u001b[26;35H\u001b[K\u001b[26;35H\u001b[?25h"]
[851.198247, "o", "\u001b[?25l:\r\n        logging.info(f\u001b[95m\"Request was successful on {HOST}, Code\u001b[m\u001b[27;62H\u001b[K\u001b[27;62H\u001b[?25h"]
[851.206881, "o", "\u001b[?25l\u001b[95m: {response.status_code}\"\u001b[m)\r\n        \u001b[93mreturn\u001b[m json.dumps(response.j\u001b[28;37H\u001b[K\u001b[28;37H\u001b[?25h"]
[851.208231, "o", "\u001b[?25lson(), sort_keys=\u001b[1m\u001b[96mTrue\u001b[m, indent=\u001b[95m4\u001b[m)\r\n    \u001b[93melse\u001b[m:\u001b[29;10H\u001b[K\u001b[1;29r\u001b[29;1H\r\n\u001b[1;30r\u001b[29;9Hlogging.erro\u001b[30;11H\u001b[1m(paste) --\u001b[m\u001b[30;103H\u001b[K\u001b[29;21H\u001b[?25h"]
