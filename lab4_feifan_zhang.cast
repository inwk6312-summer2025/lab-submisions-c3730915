[3386.039912, "o", "\u001b[?25lko \u001b[38;5;81mimport\u001b[m Netmiko\r\n\u001b[38;5;81mimport\u001b[m logging\u001b[2;15H\u001b[K\u001b[3;1H\u001b[K\u001b[4;1H\u001b[96m# Optional: Enable logging to st\u001b[m\u001b[4;33H\u001b[K\u001b[4;33H\u001b[?25h"]
