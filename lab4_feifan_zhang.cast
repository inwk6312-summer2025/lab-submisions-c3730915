[2482.521516, "o", "\u001b[?25l\u001b[95m1.103\"\u001b[m,\r\n    \u001b[95m\"username\"\u001b[m: \u001b[95m\"student\"\u001b[m,\u001b[25;27H\u001b[K\u001b[26;1H    \u001b[95m\"password\"\u001b[m: \u001b[95m\"Meilab123\"\u001b[m,\u001b[26;29H\u001b[K\u001b[26;29H\u001b[?25h"]
[2482.522866, "o", "\u001b[?25l\r\n    \u001b[95m\"secret\"\u001b[m: \u001b[95m\"cisco\"\u001b[m,\u001b[27;23H\u001b[K\u001b[28;1H    \u001b[95m\"port\"\u001b[m: \u001b[95m\"22\"\u001b[m\u001b[28;17H\u001b[K\u001b[29;1H}\u001b[29;2H\u001b[K\u001b[1;29r\u001b[1;1H\u001b[3M\u001b[1;30r\u001b[28;1H\u001b[96m# List of routers\u001b[m\r\nr\u001b[30;11H\u001b[1m(paste) --\u001b[m\u001b[30;103H\u001b[K\u001b[29;2H\u001b[?25h"]
[2482.526797, "o", "\u001b[?25louters = [r1, r2, r3]\rroute\u001b[?25h"]
[2482.527839, "o", "\u001b[?25l\u001b[1;29r\u001b[1;1H\u001b[3M\u001b[1;30r\u001b[28;1H\u001b[96m# List of show commands to execute\u001b[m\r\ncommands = [\u001b[9C\u001b[?25h"]
[2482.528807, "o", "\u001b[?25l\u001b[1;29r\u001b[1;1H\u001b[2M\u001b[1;30r\u001b[28;5H\u001b[95m\"show interface description\"\u001b[m,\r\n    \u001b[95m\"show ip interface brief\"\u001b[m,\u001b[29;9H\u001b[?25h"]
[2482.533528, "o", "\u001b[?25l\u001b[1;29r\u001b[1;1H\u001b[5M\u001b[1;30r\u001b[25;5H\u001b[95m\"show version\"\u001b[m\r\n]\r\n\r\n\u001b[93mfor\u001b[m device \u001b[93min\u001b[m routers:\r\n    \u001b[1m\u001b[96mprint\u001b[m(f\u001b[95m\"\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95mConnecting to {device['ip']}...\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m\"\u001b[m + \u001b[95m\"-\"\u001b[m*\u001b[95m100\u001b[m)\u001b[29;12H\u001b[?25h"]
[2482.534677, "o", "\u001b[?25l\u001b[1;29r\u001b[29;1H\r\n\u001b[1;30r\u001b[29;5Hnet_connect = ConnectHandler(**device)\r    n\u001b[?25h"]
[2482.535788, "o", "\u001b[?25l\u001b[1;29r\u001b[1;1H\u001b[3M\u001b[1;30r\u001b[27;5Hnet_connect.enable()\u001b[29;5H\u001b[93mfor\u001b[m cmd \u001b[93min\u001b[m commands:\u001b[19C\u001b[?25h"]
[2482.540019, "o", "\u001b[?25l\u001b[1;29r\u001b[29;1H\r\n\u001b[1;30r\u001b[29;9H\u001b[1m\u001b[96mprint\u001b[m(f\u001b[95m\"\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m>> Output of '{cmd}':\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m\"\u001b[m)\u001b[29;16H\u001b[?25h"]
[2482.541072, "o", "\u001b[?25l\u001b[1;29r\u001b[1;1H\u001b[2M\u001b[1;30r\u001b[28;9Houtput = net_connect.send_command(cmd)\u001b[29;9H\u001b[1m\u001b[96mprint\u001b[m(output)     \u001b[?25h"]
[2482.541568, "o", "\u001b[?25l\u001b[30;1H\u001b[K"]
