[959.709258, "o", "\u001b[?25licAuth\r\nimp\u001b[4;4H\u001b[K\u001b[4;4H\u001b[?25h"]
[959.70999, "o", "\u001b[?25l\r\u001b[38;5;81mimport\u001b[m json\u001b[5;1H\u001b[K\u001b[6;1H\u001b[96m# 设置日志\u001b[m\u001b[6;11H\u001b[K\u001b[6;11H\u001b[?25h"]
[959.711134, "o", "\u001b[?25l\u001b[96m格式\u001b[m\r\nlogging.basicConfig(level=logging.INFO, \u001b[1m\u001b[96mformat\u001b[m=\u001b[95m'%(\u001b[m\u001b[7;51H\u001b[K\u001b[7;51H\u001b[?25h"]
[959.721301, "o", "\u001b[?25l\u001b[95mname)s - %(levelname)s - %(message)s'\u001b[m)\u001b[8;1H\u001b[K\u001b[9;1H\u001b[96m# 设\u001b[m\u001b[9;5H\u001b[K\u001b[9;5H\u001b[?25h"]
[959.722593, "o", "\u001b[?25l\u001b[96m备基本信息\u001b[m\r\nHOST = \u001b[95m'192.168.1.101'\u001b[m\u001b[10;23H\u001b[K\u001b[11;1HUSER = \u001b[95m'student'\u001b[m\u001b[11;17H\u001b[K\u001b[12;1HPASS = \u001b[95m'M\u001b[m\u001b[12;10H\u001b[K\u001b[12;10H\u001b[?25h"]
[959.723869, "o", "\u001b[?25l\u001b[95meilab123'\u001b[m\r\nBASE_URL = \u001b[95m'http://{0}/restconf/api/running/'\u001b[m.format(H\u001b[13;55H\u001b[K\u001b[13;55H\u001b[?25h"]
[959.728441, "o", "\u001b[?25lOST)\u001b[14;1H\u001b[K\u001b[15;1H\u001b[96m# 获取接口信息\u001b[m\u001b[15;15H\u001b[K\u001b[16;1H\u001b[93mdef\u001b[m \u001b[1m\u001b[96mget_interfaces\u001b[m(append_url, interf\u001b[16;38H\u001b[K\u001b[16;38H\u001b[?25h"]
[959.729582, "o", "\u001b[?25lace_name):\r\n    \u001b[96m# 拼接完整 URL\u001b[m\u001b[17;19H\u001b[K\u001b[18;1H    url = BASE_URL + append_u\u001b[18;30H\u001b[K\u001b[18;30H\u001b[?25h"]
[959.730604, "o", "\u001b[?25lrl + interface_name\r\n    auth = HTTPBasicAuth(USER, PASS)\u001b[19;37H\u001b[K\u001b[20;1H    he\u001b[20;7H\u001b[K\u001b[20;7H\u001b[?25h"]
[959.731605, "o", "\u001b[?25laders = {\u001b[95m'Accept'\u001b[m: \u001b[95m'application/vnd.yang.data+json'\u001b[m}\u001b[21;1H\u001b[K\u001b[22;1H    \u001b[96m# 附\u001b[m\u001b[22;9H\u001b[K\u001b[22;9H\u001b[?25h"]
[959.738419, "o", "\u001b[?25l\u001b[96m加参数：用于调试/调深输出等\u001b[m\r\n    params = {\u001b[95m'deep'\u001b[m: \u001b[23;23H\u001b[K\u001b[23;23H\u001b[?25h"]
[959.739672, "o", "\u001b[?25l\u001b[1m\u001b[96mTrue\u001b[m}\r\n    logging.info(f\u001b[95m\"URL ==> {url}\"\u001b[m)\u001b[24;35H\u001b[K\u001b[25;1H\u001b[K\u001b[26;1H    \u001b[96m# 发起 GET 请\u001b[m\u001b[26;18H\u001b[K\u001b[26;18H\u001b[?25h"]
[959.740603, "o", "\u001b[?25l\u001b[96m求\u001b[m\r\n    response = requests.get(url, auth=auth, headers=headers,\u001b[27;61H\u001b[K\u001b[27;61H\u001b[?25h"]
[959.745367, "o", "\u001b[?25l params=params)\u001b[28;1H\u001b[K\u001b[29;1H    \u001b[96m# 响应处理\u001b[m\u001b[29;15H\u001b[K\u001b[1;29r\u001b[29;1H\r\n\u001b[1;30r\u001b[29;5H\u001b[93mif\u001b[m response.status_code\u001b[30;11H\u001b[1m(paste) --\u001b[m\u001b[30;103H\u001b[K\u001b[29;28H\u001b[?25h"]
